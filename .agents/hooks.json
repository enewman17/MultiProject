{
  "auto-deploy": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python ../.vscode/deploy.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
